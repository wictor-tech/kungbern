{
  "name": "lupnumber-short",
  "version": "1.0.0",
  "description": "15-20s vertical short for lupnumber.com built with Remotion",
  "private": true,
  "scripts": {
    "start": "remotion studio",
    "build": "remotion render LupnumberShort out/lupnumber-short.mp4",
    "build:explainer": "remotion render LupnumberExplainer out/lupnumber-explainer.mp4",
    "upgrade": "remotion upgrade",
    "klipp": "node shorts/scripts/build.mjs",
    "klipp:nytt": "node shorts/scripts/new.mjs",
    "klipp:alla": "node shorts/scripts/build.mjs all",
    "klipp:test": "node shorts/scripts/test.mjs",
    "klipp:serie": "node shorts/scripts/overview.mjs",
    "film": "node shorts/scripts/film.mjs",
    "hero": "node shorts/scripts/hero.mjs",
    "material": "node shorts/scripts/material.mjs",
    "index": "node shorts/scripts/index.mjs",
    "verify": "node shorts/scripts/verify.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.200",
    "@remotion/cli": "4.0.200",
    "@remotion/renderer": "4.0.200",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.200"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "typescript": "5.4.5"
  }
}
