# VERAPEP local / preview environment
PORT=3000
BASE_URL=http://localhost:3000
APP_ENV=development
TEST_COMMERCE_MODE=true

# Admin bootstrap. Change before any internet-facing production use.
ADMIN_EMAIL=admin@verapep.local
ADMIN_PASSWORD=ChangeMe-123!
# Optional production bootstrap TOTP secret for the owner. Per-user MFA enrollment is still required before launch.
ADMIN_TOTP_SECRET=
# Encrypts per-user TOTP seeds at rest. Use a random 32+ character secret in production.
MFA_ENCRYPTION_KEY=

# Persistence. Preview defaults to ./data. Production must use persistent storage
# or a managed database. SQLite production is blocked by default.
DATA_DIR=
PRODUCTION_PERSISTENCE_ACK=false
ALLOW_SQLITE_PRODUCTION=false

# Stripe. Use sk_test_ in preview. Live keys are accepted only when every
# production gate below is explicitly enabled. Never commit real secrets.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
LEGAL_REVIEW_ACK=false
COMMERCE_ALLOWLIST=
ENABLE_LIVE_COMMERCE=false
LIVE_COMMERCE_ACK=
# Required exact live acknowledgement value when enabling commerce:
# I_UNDERSTAND_LIVE_COMMERCE_REQUIRES_LEGAL_APPROVAL

# Transactional email. outbox is safe for preview. webhook hands structured
# messages to your chosen mail relay/provider integration.
EMAIL_DELIVERY_MODE=outbox
EMAIL_FROM=VERAPEP <no-reply@verapep.invalid>
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=

# Monitoring webhook for operational alerts (5xx and selected service events).
MONITORING_WEBHOOK_URL=

# Legal/company identity shown on customer-facing policy pages.
COMPANY_LEGAL_NAME=
COMPANY_REGISTRATION_NUMBER=
COMPANY_ADDRESS=
SUPPORT_EMAIL=hello@verapep.eu
PRIVACY_EMAIL=privacy@verapep.eu
TERMS_VERSION=preview-v14.1
PRIVACY_VERSION=preview-v14.1
PRIVACY_REVIEW_ACK=false
LEGAL_TERMS_REVIEW_ACK=false

# Search indexing stays off by default. Enable only after the production site,
# legal pages and product content are approved for public discovery.
PRODUCTION_SEO_INDEXING=false

# Set only after a complete staging/production payment rehearsal has passed,
# including payment, webhook, inventory, email, return/withdrawal and refund.
PRODUCTION_CHECKOUT_TEST_ACK=false

# Explicit acknowledgement required before retrying failed transactional email via npm run email:retry.
EMAIL_RETRY_ACK=
EMAIL_RETRY_INCLUDE_STORED=false

# v17 — publication gate. Production always uses "strict" (only products with a recorded
# compliance approval are public). In preview, "strict" also hides unreviewed lower-risk products;
# the default "preview" hides only products flagged high-risk.
PUBLICATION_GATE=preview
# v17 — set to true when running behind a reverse proxy (Render, nginx) so rate limits use the
# client address from X-Forwarded-For instead of the proxy address. Leave false when exposed directly.
TRUST_PROXY=false
