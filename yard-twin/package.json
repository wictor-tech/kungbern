{
  "name": "lupnumber-yard-twin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LUPNUMBER Yard Twin – kalibrerad och backtestad digital tvilling av gård och dockar",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest run test/perf.test.ts --reporter=verbose",
    "server": "node --experimental-strip-types src/server/main.ts",
    "demo-data": "node --experimental-strip-types scripts/build-demo-data.ts",
    "scenario": "node --experimental-strip-types scripts/run-scenario.ts",
    "recalibrate": "node --experimental-strip-types scripts/recalibrate.ts",
    "test:e2e": "playwright test",
    "ci": "tsc --noEmit && vitest run && vite build",
    "build:embed": "VITE_EMBED=1 vite build --outDir dist-embed"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
