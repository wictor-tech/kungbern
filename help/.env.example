# Allt är valfritt – appen fungerar utan nycklar (nyckelordssökning, ingen AI-mening).

# Claude: väljer bästa guide bland kandidaterna och skriver en kort mening.
ANTHROPIC_API_KEY=
HELP_AI_MODEL=claude-haiku-5-5

# Embeddings (semantisk sökning). Voyage rekommenderas.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite

# Databas. Tom = inbyggd PGlite i .data/pglite (bra för utveckling/demo).
# I produktion: Postgres, t.ex. Neon.
DATABASE_URL=

# Admin
ADMIN_PASSWORD=byt-mig
SESSION_SECRET=byt-till-en-lång-slumpsträng

# Var uppladdade filer sparas (lokalt). Byts mot S3/R2 i produktion.
UPLOAD_DIR=.data/uploads

# Zendesk: supportärenden skapas direkt i Zendesk (Admin Center → Apps and integrations → Zendesk API → API-token).
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=

# Valfritt: skicka även en kopia av varje ärende hit som JSON (t.ex. en Slack-webhook).
SUPPORT_WEBHOOK_URL=

# Vercel Blob för uppladdade bilder/video (sätts automatiskt när Blob kopplas i Vercel).
BLOB_READ_WRITE_TOKEN=

# Sajter som får anropa API:t och visa hjälpen i "?"-panelen (kommaseparerat).
HELP_ALLOWED_ORIGINS=https://app.lupnumber.com
